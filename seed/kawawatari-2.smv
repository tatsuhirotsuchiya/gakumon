MODULE main
VAR
  R0: {from, boat, to};
  R1: {from, boat, to};
  R2: {from, boat, to};
  W0: {from, boat, to};
  W1: {from, boat, to};
  W2: {from, boat, to};

  Boat : {from, to}; -- ボートの位置

DEFINE
  ON_BOARD := R0 = boat | R1 = boat | R2 = boat 
     | W0 = boat | W1 = boat | W2 = boat;

ASSIGN
  init(R0) := from;
  init(R1) := from;
  init(R2) := from;
  init(W0) := from;
  init(W1) := from;
  init(W2) := from;
  init(Boat) := from;
 
  next(Boat) := case
    Boat = from & ON_BOARD: to;
    Boat = to & ON_BOARD : from; 
    !ON_BOARD : Boat;
  esac;

  next(R0) := case
    R0 = from & !ON_BOARD : {from, boat};
    R0 = from & ON_BOARD : to;
    R0 = boat & next(Boat) = to : to;
    R0 = boat & next(Boat) = from : from;
    R0 = to & !ON_BOARD : {to, boat};
    R0 = to & ON_BOARD : from;
  esac;

  next(R1) := case
    R1 = from & !ON_BOARD : {from, boat};
    R1 = from & ON_BOARD : to;
    R1 = boat & next(Boat) = to : to;
    R1 = boat & next(Boat) = from : from;
    R1 = to & !ON_BOARD : {to, boat};
    R1 = to & ON_BOARD : from;
  esac;

  next(R2) := case
    R2 = from & !ON_BOARD : {from, boat};
    R2 = from & ON_BOARD : to;
    R2 = boat & next(Boat) = to : to;
    R2 = boat & next(Boat) = from : from;
    R2 = to & !ON_BOARD : {to, boat};
    R2 = to & ON_BOARD : from;
  esac;

  next(W0) := case
    W0 = from & !ON_BOARD : {from, boat};
    W0 = from & ON_BOARD : to;
    W0 = boat & next(Boat) = to : to;
    W0 = boat & next(Boat) = from : from;
    W0 = to & !ON_BOARD : {to, boat};
    W0 = to & ON_BOARD : from;
  esac;

  next(W1) := case
    W1 = from & !ON_BOARD : {from, boat};
    W1 = from & ON_BOARD : to;
    W1 = boat & next(Boat) = to : to;
    W1 = boat & next(Boat) = from : from;
    W1 = to & !ON_BOARD : {to, boat};
    W1 = to & ON_BOARD : from;
  esac;


  next(W2) := case
    W2 = from & !ON_BOARD : {from, boat};
    W2 = from & ON_BOARD : to;
    W2 = boat & next(Boat) = to : to;
    W2 = boat & next(Boat) = from : from;
    W2 = to & !ON_BOARD : {to, boat};
    W2 = to & ON_BOARD : from;
  esac;

DEFINE
  goal := R0 = to & R1 = to & R2 = to & W0 = to & W1 = to & W2 = to;
--  safe := ((R0 >= W0) | (R0 = 0)) & ((R1 >= W1) | (R1 = 0)) & ((RB >= WB) | (RB = 0));
--  crew := (boat = m01 | boat = m10) -> ((RB + WB = 1) | (RB + WB = 2));
--  ok0 :=  boat = 0 -> ((R0 >= RC) & (W0 >= WC));
--  ok1 :=  boat = 1 -> ((R1 >= RC) & (W1 >= WC));
--  rule := safe & crew & ok0 & ok1;

-- LTLSPEC
--   !(rule U goal) -- 「ruleが満たされ続けて，やがてgoalが成り立つ」ということが，ない

-- LTLSPEC
--   !(G (rule) -> F goal)

-- INVAR
--   rule
LTLSPEC
   F goal

   
